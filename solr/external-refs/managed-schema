<?xml version="1.0" encoding="UTF-8"?>
<schema name="external-refs" version="1.6">

    <!-- Synthetic unique key: pid!ds -->
    <field name="id"
        type="string"
        indexed="true"
        stored="true"
        docValues="true"
        required="true"
        multiValued="false" />

    <uniqueKey>id</uniqueKey>

    <!-- Kramerius PID -->
    <field name="pid"
        type="string"
        indexed="true"
        stored="true"
        docValues="true"
        multiValued="false" />

    <!-- Datastream (IMG_FULL, IMG_PREVIEW, ALTO, PDF, etc.) -->
    <field name="ds"
        type="string"
        indexed="true"
        stored="true"
        docValues="true"
        multiValued="false" />

    <!-- Resource URI (JP2 path, PDF path, etc.) -->
    <field name="uri"
        type="string"
        indexed="true"
        stored="true"
        docValues="true"
        multiValued="false" />

    <!-- Ingestion/update timestamp -->
    <field name="timestamp"
        type="tdate"
        indexed="true"
        stored="true"
        docValues="true"
        multiValued="false"
        default="NOW" />

    <!-- Orphaned flag -->
    <field name="orphaned"
        type="boolean"
        indexed="true"
        stored="true"
        docValues="true"
        multiValued="false"
        default="false" />

    <!-- Solr internal versioning field -->
    <field name="_version_"
        type="long"
        indexed="true"
        stored="true" />

    <!-- Types -->
    <fieldType name="string"
        class="solr.StrField"
        sortMissingLast="true" />

    <fieldType name="tdate"
        class="solr.TrieDateField"
        precisionStep="0" />

    <fieldType name="long"
        class="solr.TrieLongField"
        precisionStep="0" />

    <fieldType name="boolean"
        class="solr.BoolField" />

</schema>